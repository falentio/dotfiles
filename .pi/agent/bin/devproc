#!/bin/sh
# devproc — run and inspect long-running dev processes (dev server, watcher,
# worker, tunnel) as tmux DEV sessions, one per worktree.
#
# Session name: DEV <repo> <branch> <port>
# The name is the registry: it survives across agents, shells, and machines,
# so `tmux ls` alone says what runs, where, and on which port.
#
# A detached watchdog tears a session down after DEVPROC_IDLE_TIMEOUT seconds
# (default 1800) with no output; see the idle watchdog section.
set -eu

DEFAULT_PORT=3000
MAX_PORT=3999

# Seconds a session may go without output before it is torn down; 0 disables.
IDLE_TIMEOUT="${DEVPROC_IDLE_TIMEOUT:-1800}"

die() { echo "devproc: $*" >&2; exit 1; }

# --- identity ---------------------------------------------------------------

# repo = parent dir of the git common dir; resolves in a worktree and the main
# checkout alike. Dots become _ because tmux rewrites . and : to _ in names.
repo_name() {
  common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
    || die "not inside a git repository"
  basename "$(dirname "$common")" | tr . _
}

branch_name() {
  git branch --show-current | tr . _
}

# lowest free TCP port in [DEFAULT_PORT, MAX_PORT]
free_port() {
  p=$DEFAULT_PORT
  while [ "$p" -le "$MAX_PORT" ]; do
    ss -ltnH "sport = :$p" 2>/dev/null | grep -q . || { echo "$p"; return; }
    p=$((p + 1))
  done
  die "no free port in $DEFAULT_PORT-$MAX_PORT"
}

# the address a dev server should bind: the wildcard, so it listens on every
# interface at once — loopback, LAN, and tailnet alike.
host_addr() {
  echo 0.0.0.0
}

# full session name for this worktree, with a freshly chosen port
session_name() {
  r=$(repo_name)
  b=$(branch_name)
  p=$(free_port)
  echo "DEV $r $b $p"
}

# --- commands ---------------------------------------------------------------

cmd_name() {
  session_name
}

cmd_host() {
  host_addr
}

# {port} and {host} in the command are replaced: the chosen port, so the name
# and the process agree on one number, and the address to bind.
cmd_start() {
  [ $# -ge 1 ] || die "usage: devproc start <command with {port} and {host}...>"
  existing=$(sessions_here)
  if [ -n "$existing" ]; then
    printf 'devproc: this worktree already runs a DEV session:\n%s\n       read it with '\''devproc read <name>'\'', restart it with '\''tmux respawn-pane -k -t =<name>: <command>'\'', or '\''devproc stop <name>'\'' first\n' "$existing" >&2
    exit 1
  fi
  name=$(session_name)
  port=$(echo "$name" | awk '{print $NF}')
  host=$(host_addr)
  cmd=$(echo "$*" | sed "s/{port}/$port/g; s/{host}/$host/g")
  slug=$(echo "$name" | tr ' /' '__')
  log="/tmp/devproc-$slug.log"
  tmux new-session -d -s "$name" -c "$PWD" "$cmd 2>&1 | tee '$log'"
  tmux set-option -w -t "=$name:" remain-on-exit on
  start_watchdog "$name"
  echo "$name"
}

# inventory, decoded: one line per DEV session
cmd_list() {
  tmux ls -F '#{session_name}' 2>/dev/null \
    | awk '$1=="DEV" && NF>=4 && $NF~/^[0-9]+$/ {b=$3; for(i=4;i<NF;i++) b=b"/"$i; printf "%-46s repo=%s branch=%s port=%s\n", $0, $2, b, $NF}' \
    || true
}

# every DEV session whose pane sits in this worktree, whatever its name
sessions_here() {
  tmux ls -F '#{session_name}' 2>/dev/null | grep '^DEV ' | while IFS= read -r s; do
    # pane_current_path empties when the process dies; pane_start_path survives,
    # which is what keeps a crashed session findable.
    p=$(tmux display-message -p -t "=$s:" '#{pane_current_path}' 2>/dev/null)
    [ -n "$p" ] || p=$(tmux display-message -p -t "=$s:" '#{pane_start_path}' 2>/dev/null)
    if [ "$p" = "$PWD" ]; then echo "$s"; fi
  done || true
}

# this worktree's session name, if one is running
cmd_here() {
  sessions_here | head -1
}

# port -> repo, branch, and worktree of the process behind it
cmd_infer() {
  [ $# -ge 1 ] || die "usage: devproc infer <port>"
  port=$1
  pid=$(fuser -n tcp "$port" 2>/dev/null | tr -d ' ' | cut -d: -f2) \
    || die "nothing listening on $port"
  [ -n "$pid" ] || die "nothing listening on $port"
  cwd=$(readlink "/proc/$pid/cwd") || die "cannot read cwd of pid $pid"
  common=$(git -C "$cwd" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
    || die "pid $pid (cwd $cwd) is not in a git repository"
  echo "repo=$(basename "$(dirname "$common")" | tr . _) branch=$(git -C "$cwd" branch --show-current | tr . _) worktree=$cwd pid=$pid"
}

# resolve a target argument, or this worktree's session
target() {
  if [ $# -ge 1 ]; then echo "$1"; else cmd_here | head -1; fi
}

# -J joins rows tmux wrapped at the pane width back into one line, so a log
# line longer than the 80-column default pane comes back whole. tmux flags a
# row as wrapped only when it actually overflowed, so a line that lands exactly
# on the width is not joined to the next hard newline.
cmd_read() {
  t=$(target "$@")
  [ -n "$t" ] || die "no session for this worktree; pass a name or run devproc list"
  tmux capture-pane -p -J -S -200 -t "=$t:"
}

cmd_stop() {
  t=$(target "$@")
  [ -n "$t" ] || die "no session for this worktree; pass a name or run devproc list"
  stop_watchdog "$t"
  tmux kill-session -t "=$t"
  echo "stopped $t"
}

# --- idle watchdog ----------------------------------------------------------

# A session that writes nothing for IDLE_TIMEOUT seconds is torn down. Silence
# is read from tmux's window_activity: the timestamp of the last change to the
# window's content, i.e. the last byte the process wrote to the pane — exactly
# "nothing on stdout/stderr". A server that keeps logging (or answers a
# request) resets it; a finished, wedged, or crashed one does not.

idle_enabled() {
  case "$IDLE_TIMEOUT" in ''|*[!0-9]*) return 1 ;; esac
  [ "$IDLE_TIMEOUT" -gt 0 ]
}

watch_pidfile() {
  echo "/tmp/devproc-$(echo "$1" | tr ' /' '__').watch"
}

# Detached one-per-session loop. It exits by itself once the session is gone,
# so a normal `devproc stop` leaves no watchdog behind; stop_watchdog just
# makes that immediate. On idle teardown it also removes the log, so an
# unattended session leaves no residue at all.
start_watchdog() {
  name=$1
  idle_enabled || return 0
  pidfile=$(watch_pidfile "$name")
  log="/tmp/devproc-$(echo "$name" | tr ' /' '__').log"
  if [ -f "$pidfile" ]; then
    old=$(cat "$pidfile" 2>/dev/null || echo)
    if [ -n "$old" ] && kill -0 "$old" 2>/dev/null; then return 0; fi
  fi
  poll=$((IDLE_TIMEOUT / 4))
  [ "$poll" -ge 1 ] || poll=1
  [ "$poll" -le 30 ] || poll=30
  setsid sh -c '
    name=$1 idle=$2 poll=$3 pidfile=$4 log=$5
    echo $$ > "$pidfile"
    while tmux has-session -t "=$name" 2>/dev/null; do
      act=$(tmux display-message -p -t "=$name:" "#{window_activity}" 2>/dev/null) || act=
      [ -n "$act" ] || act=$(date +%s)
      if [ $(( $(date +%s) - act )) -ge "$idle" ]; then
        tmux kill-session -t "=$name" 2>/dev/null || true
        rm -f "$log"
        break
      fi
      sleep "$poll"
    done
    rm -f "$pidfile"
  ' _ "$name" "$IDLE_TIMEOUT" "$poll" "$pidfile" "$log" >/dev/null 2>&1 &
}

stop_watchdog() {
  pidfile=$(watch_pidfile "$1")
  [ -f "$pidfile" ] || return 0
  pid=$(cat "$pidfile" 2>/dev/null || echo)
  [ -z "$pid" ] || kill "$pid" 2>/dev/null || true
  rm -f "$pidfile"
}

# arm the watchdog on an already-running session
cmd_watch() {
  t=$(target "$@")
  [ -n "$t" ] || die "no session for this worktree; pass a name or run devproc list"
  tmux has-session -t "=$t" 2>/dev/null || die "no such session: $t"
  idle_enabled || die "DEVPROC_IDLE_TIMEOUT=$IDLE_TIMEOUT disables the watchdog"
  start_watchdog "$t"
  echo "watching $t: teardown after ${IDLE_TIMEOUT}s with no output"
}

usage() {
  cat <<'EOF'
devproc — long-running dev processes as tmux DEV sessions.

  devproc name              print the DEV session name for this worktree
  devproc host              print the bind address ({host}: always 0.0.0.0)
  devproc start <cmd>       start <cmd> in a DEV session ({port} -> chosen port,
                            {host} -> 0.0.0.0, the wildcard)
  devproc list              inventory every DEV session, decoded
  devproc here              this worktree's running session, if any
  devproc read [target]     tail a session, wrapped lines rejoined
                            (default: this worktree's)
  devproc stop [target]     kill a session (default: this worktree's)
  devproc watch [target]    arm the idle watchdog on a session
  devproc infer <port>      port -> repo, branch, worktree, pid

A session is torn down after DEVPROC_IDLE_TIMEOUT seconds (default 1800) with
no output on stdout/stderr; 0 disables it.

Session name: DEV <repo> <branch> <port>. One per worktree.
EOF
}

case "${1:-}" in
  name)  shift; cmd_name "$@" ;;
  host)  shift; cmd_host "$@" ;;
  start) shift; cmd_start "$@" ;;
  list)  shift; cmd_list "$@" ;;
  here)  shift; cmd_here "$@" ;;
  read)  shift; cmd_read "$@" ;;
  stop)  shift; cmd_stop "$@" ;;
  watch) shift; cmd_watch "$@" ;;
  infer) shift; cmd_infer "$@" ;;
  ""|-h|--help|help) usage ;;
  *) usage >&2; die "unknown command: $1" ;;
esac
